{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npx vite build && node -e \"import('fs').then(fs=>{try{fs.rmSync('dist/public',{recursive:true,force:true})}catch(e){}})\"",
  "outputDirectory": "dist",
  "cleanUrls": true
}
